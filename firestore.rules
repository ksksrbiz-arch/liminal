rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidSaveData(data) {
      return data.keys().hasAll(['updatedAt']) 
        && data.updatedAt == request.time
        && (!data.keys().hasAny(['notesFound']) || (data.notesFound is list && data.notesFound.size() <= 100))
        && (!data.keys().hasAny(['drawersOpened']) || (data.drawersOpened is list && data.drawersOpened.size() <= 100));
    }

    match /users/{userId}/save/data {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidSaveData(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidSaveData(incoming()) 
        && incoming().diff(existing()).affectedKeys().hasOnly(['notesFound', 'drawersOpened', 'updatedAt']);
    }
  }
}
